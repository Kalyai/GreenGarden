# Шаблон nginx для сайта «Зелёный дворик».
#
# Рендерится официальным образом nginx: /docker-entrypoint.d/20-envsubst-*.sh
# подставляет переменные окружения (${DOMAIN}) и кладёт результат в
# /etc/nginx/conf.d/default.conf. Переменные nginx ($host, $uri, $remote_addr)
# не затрагиваются — envsubst заменяет только имена, объявленные в окружении.
#
# ВАЖНО: статику отдаёт nginx, а не приложение, поэтому заголовки безопасности
# живут здесь (snippets/security-headers.conf) и обязаны совпадать со значениями
# в backend/app.py (CSP, end_headers). Приложение отвечает только за /api/,
# где заголовки ставит само, — поэтому в location /api/ сниппет не подключают
# (иначе заголовки задвоятся).
#
# Конфигурация следует разделу 4 SECURITY-AUDIT.md.

# ---------- http-контекст: зоны лимитов и сжатие ----------

# Дублируют лимиты приложения, но отсекают флуд до проксирования:
# документы — 30 зап/мин, статика — 300 зап/мин (страница каталога тянет
# около сотни изображений), API — своя зона.
#
# Зона API отделена намеренно. Счётчик в limit_req общий для зоны, а не для
# location, поэтому при одной зоне на документы и API просмотр страниц
# исчерпывал бакет и приём заявок начинал отвечать 429 — на практике это
# заметно за корпоративным NAT или у мобильного оператора, где за одним
# адресом сидит много посетителей. Проверено: 10 запросов страниц подряд
# блокировали третью отправку формы.
limit_req_zone  $binary_remote_addr zone=per_ip:10m  rate=30r/m;
limit_req_zone  $binary_remote_addr zone=assets:10m  rate=300r/m;
limit_req_zone  $binary_remote_addr zone=api:10m     rate=30r/m;
limit_conn_zone $binary_remote_addr zone=per_conn:10m;

# Штатный ответ nginx на превышение — 503 «Service Unavailable», что выглядит
# как отказ сервера и в мониторинге, и для клиента. Приложение на то же самое
# событие отвечает 429, поэтому статусы приводим к одному виду.
limit_req_status  429;
limit_conn_status 429;

# Журнал ошибок пишем дважды: в файл (его читают fail2ban и logrotate —
# каталог /var/log/nginx примонтирован с хоста) и в stderr, чтобы он оставался
# доступен через `docker compose logs nginx`. Одна директива не наследуется
# от уровня main, поэтому оба журнала объявлены явно.
error_log /var/log/nginx/error.log warn;
error_log /dev/stderr              warn;

gzip            on;
gzip_vary       on;
gzip_proxied    any;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_types      text/css application/javascript application/json image/svg+xml text/plain application/xml text/xml;

# ---------- порт 80: домен ----------
server {
    listen      80;
    listen      [::]:80;
    server_name ${DOMAIN};

    # Проверки Let's Encrypt обслуживаются ДО редиректа на HTTPS: иначе
    # http-01 challenge не пройдёт и сертификат не продлится.
    location ^~ /.well-known/acme-challenge/ {
        root         /var/www/certbot;
        default_type text/plain;
    }

    location / { return 301 https://$host$request_uri; }
}

# ---------- порт 80: всё, что не наш домен ----------
# Обращения по IP и с чужим Host (сканеры, ботнеты) не должны получать ни
# редирект на домен, ни содержимое сайта.
server {
    listen      80 default_server;
    listen      [::]:80 default_server;
    server_name _;

    # Точка живости для HEALTHCHECK контейнера и внешнего аптайм-мониторинга.
    # Отвечает на любой Host, поэтому проверка изнутри контейнера
    # (http://127.0.0.1/nginx-health) попадает именно сюда.
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # 444 — закрыть соединение без ответа: не тратим ресурсы и не сообщаем,
    # что здесь вообще что-то есть.
    location / { return 444; }
}

# ---------- порт 443: чужой SNI ----------
# Отклоняем рукопожатие, если имя сервера не совпало: сертификат не
# показывается, содержимое сайта не отдаётся (nginx >= 1.19.4).
server {
    listen      443 ssl default_server;
    listen      [::]:443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
    return 444;
}

# ---------- порт 443: боевой сервер ----------
server {
    listen      443 ssl;
    listen      [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # A05: не раскрывать версию nginx
    server_tokens off;

    # Потолок тела запроса — тот же, что в приложении (MAX_BODY_BYTES, 32 КБ).
    # nginx отсекает oversized-запросы до проксирования.
    client_max_body_size  32k;
    client_body_timeout   10s;
    client_header_timeout 10s;
    send_timeout          10s;

    limit_conn per_conn 20;

    # Файлы сайта вшиты в образ (стадия static в Dockerfile)
    root  /usr/share/nginx/html;

    # Служебные каталоги. В образ nginx они не копируются вовсе — это второй
    # слой поверх DENIED_DIRS приложения. 404, а не 403: ответ не должен
    # подтверждать, что каталог существует.
    location ~ ^/(backend|tools|deploy|\.)/ { return 404; }

    # Статика: длинный кеш. Инвалидация — версией в ?v= внутри HTML,
    # поэтому сами HTML-страницы ниже не кешируются.
    # Директивы expires здесь намеренно нет: она добавила бы второй
    # Cache-Control поверх нашего, и заголовок пришёл бы клиенту дважды.
    # 2592000 секунд = 30 дней.
    location ~* \.(?:jpg|jpeg|png|webp|avif|gif|svg|ico|css|js|woff2?)$ {
        limit_req zone=assets burst=200 nodelay;
        include   /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=2592000, immutable" always;
        access_log off;
        try_files $uri =404;
    }

    # API приложения: приём заявок. Заголовки безопасности здесь ставит
    # backend/app.py, поэтому сниппет не подключается.
    location /api/ {
        limit_req zone=api burst=10 nodelay;
        # Резолвер Docker и переменная в proxy_pass обязательны. С именем,
        # записанным буквально, nginx резолвит адрес ОДИН РАЗ при старте:
        # после docker compose up -d, когда контейнер app пересоздан и получил
        # новый IP, nginx продолжит ходить на прежний адрес и будет отвечать
        # 502/504 до ручной перезагрузки. Переменная заставляет выполнять
        # запрос к DNS (127.0.0.11 — встроенный резолвер Docker) на каждый
        # запрос с кешированием на 10 секунд.
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $app_upstream http://app:8000;
        proxy_pass $app_upstream;
        proxy_http_version 1.1;
        # КРИТИЧНО: перезаписывать, а не дополнять. $proxy_add_x_forwarded_for
        # склеил бы значение клиента со своим, и посетитель смог бы подставить
        # чужой IP, обходя лимиты приложения и подделывая журнал.
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host              $host;
        proxy_set_header Connection        "";
        proxy_read_timeout 30s;
    }

    # Каталог и админка получают актуальные данные из одного процесса.
    # ^~ для загруженных фото обязателен: иначе regex статики вернёт 404.
    location = /admin {
        limit_req zone=api burst=10 nodelay;
        include /etc/nginx/snippets/proxy-app.conf;
    }
    location ^~ /admin/ {
        limit_req zone=api burst=10 nodelay;
        client_max_body_size 6m;
        include /etc/nginx/snippets/proxy-app.conf;
    }
    location ^~ /catalog-media/ {
        limit_req zone=assets burst=200 nodelay;
        include /etc/nginx/snippets/proxy-app.conf;
    }
    location ^~ /catalog/ {
        limit_req zone=per_ip burst=20 nodelay;
        include /etc/nginx/snippets/proxy-app.conf;
    }
    location ^~ /collections/ {
        limit_req zone=per_ip burst=20 nodelay;
        include /etc/nginx/snippets/proxy-app.conf;
    }

    # Главная страница — отдельной локацией. Это обязательно: try_files
    # отрабатывает в фазе precontent, то есть РАНЬШЕ модуля index (фаза
    # content), поэтому при «try_files $uri ...» запрос к «/» искал бы файл
    # с именем «/» и возвращал 404 вместо index.html.
    location = / {
        limit_req zone=per_ip burst=20 nodelay;
        include   /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files /index.html =404;
    }

    location = /catalog {
        limit_req zone=per_ip burst=20 nodelay;
        include /etc/nginx/snippets/proxy-app.conf;
    }

    location = /catalog.html { return 301 /catalog$is_args$args; }
    location = /catalog/ { return 301 /catalog$is_args$args; }
    location = /offer.html { return 301 /offer$is_args$args; }
    location = /services.html { return 301 /services$is_args$args; }
    location = /additional-services.html { return 301 /additional-services$is_args$args; }
    location = /contacts.html { return 301 /contacts$is_args$args; }
    location = /delivery.html { return 301 /delivery$is_args$args; }
    location = /guides.html { return 301 /guides$is_args$args; }
    location = /privacy-policy.html { return 301 /privacy-policy$is_args$args; }
    location = /index.html { return 301 /$is_args$args; }
    location ~ ^/(catalog|collections|guides)/([a-z0-9-]+)\.html$ { return 301 /$1/$2$is_args$args; }
    location ~ ^/(catalog|collections|guides)/([a-z0-9-]+)/$ { return 301 /$1/$2$is_args$args; }
    location ~ ^/(services|additional-services|contacts|delivery|guides|offer|privacy-policy)/$ { return 301 /$1$is_args$args; }

    location = /robots.txt {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files /robots.txt =404;
    }
    location = /sitemap.xml {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files /sitemap.xml =404;
    }

    # Остальные страницы сайта. ЧПУ /offer и /privacy-policy закрывает
    # $uri.html (в приложении за это отвечает словарь Handler.PAGES).
    # Варианта $uri/ здесь нет намеренно: он привёл бы к 403 от модуля index
    # на запрос к каталогу, а /img/ обязан давать честные 404.
    # no-cache обязателен: иначе браузер отдаст старую страницу, а контракт
    # формы с /api/lead (F-09) требует синхронной выкладки HTML и JS.
    location / {
        limit_req zone=per_ip burst=20 nodelay;
        include   /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri.html =404;
    }
}
