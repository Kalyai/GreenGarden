# Шаблон настроек развёртывания. Скопируйте в .env и заполните секреты:
#
#   cp .env.example .env && chmod 600 .env
#
# .env в репозиторий НЕ попадает (см. .gitignore) и в образы не копируется
# (см. .dockerignore). Значения читает docker compose при сборке и запуске.
# После правки .env нужен перезапуск:  docker compose up -d

# ---------- Сайт ----------
# Домен, на который выпущен сертификат Let's Encrypt. Должен совпадать с
# A-записью, направленной на этот сервер. Подставляется в конфиг nginx.
DOMAIN=greengarden.run.place

# Почта для уведомлений Let's Encrypt (истечение сертификата, отзывы CA).
CERTBOT_EMAIL=admin@greengarden.run.place

# ---------- Секреты ----------
# Пароль входа в оба Telegram-бота. Обязателен: при пустом значении вход
# закрыт для всех, заявки будут копиться в базе, но в чаты не придут.
# В исходниках и в истории git этого значения быть не должно (F-02).
ADMIN_PASSWORD=

# Токены ботов от @BotFather. Если репозиторий когда-либо публиковался
# с токенами — отзовите их и выпустите заново (чек-лист аудита, раздел 7).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_TOKEN=

# ---------- Сеть ----------
# Подсеть compose-сети. Приложение доверяет X-Forwarded-For только адресам
# из неё (TRUSTED_PROXIES), поэтому значение обязано совпадать с подсетью
# в docker-compose.yml — оно подставляется туда же. Смените, если диапазон
# уже занят другой сетью Docker на хосте:  ip route | grep 172.28
APP_SUBNET=172.28.0.0/24

# Часовой пояс. Влияет на дату заявки и на отбор «заявки за сегодня» в боте.
TZ=Europe/Moscow

# ---------- Лимиты защиты ----------
# Значения по умолчанию — из backend/app.py и SECURITY-AUDIT.md.
# Лимиты nginx (limit_req) подобраны под эти же числа: меняя одно, меняйте
# и deploy/nginx/greengarden.conf.template.
MAX_BODY_BYTES=32768
PUBLIC_LIMIT_PER_MIN=60
LEAD_LIMIT_PER_MIN=5
MIN_FILL_SECONDS=0.5
MAX_CONCURRENCY=64
TG_TIMEOUT=10
LEAD_ALERT_THRESHOLD=100
# Используется, только если приложение отдаёт статику само (локальный запуск
# без nginx). В продакшене статику отдаёт nginx со своим лимитом zone=assets.
ASSET_LIMIT_PER_MIN=600

# ---------- Бэкапы и журналы ----------
# Каталог на хосте для шифрованных архивов с заявками (ПДн, 152-ФЗ)
# и файл с парольной фразой. Права на оба ставит deploy/setup.sh: 0700/0600.
BACKUP_DIR=/var/backups/greengarden
BACKUP_PASSPHRASE_FILE=/root/.greengarden-backup-key
BACKUP_KEEP_DAYS=14

# Каталог журналов nginx на хосте. Примонтирован в контейнер как
# /var/log/nginx; из него читают fail2ban и logrotate.
LOG_DIR=/var/log/greengarden/nginx
