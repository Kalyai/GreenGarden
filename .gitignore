# захват бота: чтение и удаление всех заявок, сообщения от имени питомника.
backend/bot_token.txt
backend/admin_token.txt
backend/admin_chat_ids.txt
.env
.env.*
!.env.example

# --- Персональные данные клиентов (152-ФЗ) -------------------------------
# База заявок содержит имена и телефоны, состояния чатов — chat_id.
# В репозиторий не попадают ни при каких обстоятельствах.
backend/leads.json
backend/chats.json
backend/local_admin_password.txt
backend/local_site_password.txt
backend/local_tg_password.txt
backend/bot_auth_state.json
backend/catalog-overrides.json
backend/catalog-media/
*.json.tmp

